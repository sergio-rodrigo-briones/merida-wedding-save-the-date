# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Private wedding content: real names, dates, places and photos never reach the public repo.
# Only the *.example.ts files with sample data are committed.
**/wedding.local.ts
**/private/
.env
.env.*

# Compiled output
dist/
tmp/
out-tsc/

# Node
node_modules/
npm-debug.log

# Angular
**/.angular/
.sass-cache/
coverage/
__screenshots__/

# IDEs and editors
.idea/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# System files
.DS_Store
Thumbs.db
