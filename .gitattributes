# Normalize line endings: LF in the repo and in every working tree,
# regardless of each machine's core.autocrlf (Prettier and CI expect LF).
* text=auto eol=lf

# Binary assets: never convert or diff as text.
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
